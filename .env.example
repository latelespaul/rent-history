# Copy to .env for `docker compose up`. Placeholders only: never commit a real .env.
# Every API setting: rentrix-docs/architecture/SYSTEM_DESIGN.md §17.

# Required. At least 32 bytes, for example the output of: openssl rand -base64 48
JWT_SECRET=

# Host ports
API_PORT=8080
WEB_PORT=8081

# URL the browser uses to reach the API (written into the web's /config.js)
API_BASE_URL=http://localhost:8080/api/v1
# Web origin(s) the API accepts (comma list); match WEB_PORT
CORS_ALLOWED_ORIGINS=http://localhost:8081
APP_BASE_URL=http://localhost:8081

# Optional
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
SEED_DEMO=false

# Database. Empty DB_URL = SQLite on the rentrix-v1-sqlite-data volume (D-09).
# For PostgreSQL, run `docker compose --profile postgres up --build` with:
#   DB_URL=jdbc:postgresql://postgres:5432/rentrix
#   DB_USERNAME=rentrix
#   DB_PASSWORD=<choose a password>
DB_URL=
DB_USERNAME=
DB_PASSWORD=
