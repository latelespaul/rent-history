# Backend API base URL.
# Local dev: /api/v1 (uses Vite proxy to http://localhost:8080)
# Production: https://rentrix-wj1j.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

# App display name (used in navbar, footer, toasts)
VITE_APP_NAME=Rentrix

# Use in-file mocks instead of the real backend
# true  → frontend runs standalone (no backend needed)
# false → calls the real backend
VITE_ENABLE_MOCKS=true