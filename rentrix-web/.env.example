# Backend API origin (scheme + host + port, no path). The app appends the
# server context path /api/v1 itself. A value ending in /api/v1 is accepted.
# Default when unset: http://localhost:8080 (local Spring Boot server).
# Production: set at build time to the deployed API, e.g. https://api.example.com
# It can also be overridden after build in public/config.js (see README).
VITE_API_BASE_URL=http://localhost:8080

# Display name used in the header, footer and legal pages. Default: Rentrix
VITE_APP_NAME=Rentrix
