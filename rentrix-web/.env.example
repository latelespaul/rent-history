# API base URL baked into the build (D-04). Optional.
# Default /api/v1: same origin; `npm run dev` proxies /api to API_PROXY_TARGET.
# A deployed build can also be pointed at another API without a rebuild by
# editing public/config.js (window.__RENTRIX_CONFIG__.apiBaseUrl) on the host.
VITE_API_BASE_URL=/api/v1

# Dev server only: where the Vite proxy sends /api. Default http://localhost:8080.
# API_PROXY_TARGET=http://localhost:8080
