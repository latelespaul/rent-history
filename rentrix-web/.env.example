# Backend API base URL.
# Local dev: /api/v1 (uses Vite proxy to http://localhost:8080)
# Production: set via Vercel dashboard to https://rentrix-wj1j.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

VITE_APP_NAME=Rentrix

# true  → frontend uses in-file mocks (no backend needed)
# false → calls the real backend
VITE_ENABLE_MOCKS=false