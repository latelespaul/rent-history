# Backend API origin (scheme + host + port, no path). The app appends the
# server context path /api/v1 itself. A value ending in /api/v1 is accepted.
# Default when unset or empty: same origin as the page (relative /api/v1).
# Local dev: leave empty; the Vite dev server proxies /api to http://localhost:8080.
# Split hosting (web and API on different hosts): set at build time to the
# deployed API, e.g. https://api.example.com, or override after build in
# public/config.js (see README).
VITE_API_BASE_URL=

# Display name used in the header, footer and legal pages. Default: Rentrix
VITE_APP_NAME=Rentrix
